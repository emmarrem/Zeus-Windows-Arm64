+//! Media Foundation capture on Windows ARM64. Samples stay on the camera
+//! thread and locked memory never outlives its buffer.
+
+use std::{marker::PhantomData, ptr, slice};
+
+use windows::Win32::Foundation::RPC_E_CHANGED_MODE;
+use windows::Win32::Media::MediaFoundation::*;
+use windows::Win32::System::Com::{
+    COINIT_MULTITHREADED, CoInitializeEx, CoTaskMemFree, CoUninitialize,
+};
+use windows::core::{GUID, Interface as _, PWSTR};
+
+use super::{Mode, Pixel};
+
+const VIDEO: u32 = MF_SOURCE_READER_FIRST_VIDEO_STREAM.0 as u32;
+const MAX_FRAME_BYTES: usize = 64 * 1024 * 1024;
+const GRAY8: GUID = GUID::from_u128(0x3030_3859_0000_0010_8000_00aa00389b71);
+
+struct Platform {
+    owns_com: bool,
+    _thread: PhantomData<*mut ()>,
+}
+
+impl Platform {
+    fn open() -> windows::core::Result<Self> {
+        // SAFETY: this guard and all the COM objects it supports stay on the
+        // thread that created them.
+        let status = unsafe { CoInitializeEx(None, COINIT_MULTITHREADED) };
+        let owns_com = status != RPC_E_CHANGED_MODE;
+        if owns_com {
+            status.ok()?;
+        }
+        // SAFETY: COM is initialized on this thread.
+        if let Err(error) = unsafe { MFStartup(MF_VERSION, MFSTARTUP_NOSOCKET) } {
+            if owns_com {
+                // SAFETY: balances the successful initialization above.
+                unsafe { CoUninitialize() };
+            }
+            return Err(error);
+        }
+        Ok(Self {
+            owns_com,
+            _thread: PhantomData,
+        })
+    }
+}
+
+impl Drop for Platform {
+    fn drop(&mut self) {
+        // SAFETY: balances startup on this thread, after camera COM objects
+        // have been released.
+        unsafe {
+            let _ = MFShutdown();
+            if self.owns_com {
+                CoUninitialize();
+            }
+        }
+    }
+}
+
+fn devices() -> windows::core::Result<Vec<IMFActivate>> {
+    let mut attributes = None;
+    let mut array = ptr::null_mut();
+    let mut count = 0;
+    // SAFETY: the caller holds Platform and all out arguments are valid.
+    unsafe {
+        MFCreateAttributes(&mut attributes, 1)?;
+        let attributes = attributes.expect("MFCreateAttributes provides a store");
+        attributes.SetGUID(
+            &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE,
+            &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_GUID,
+        )?;
+        MFEnumDeviceSources(&attributes, &mut array, &mut count)?;
+        let found = if count == 0 {
+            Vec::new()
+        } else {
+            // The API owns the array allocation, and transfers the contained
+            // interface references to us.
+            slice::from_raw_parts_mut(array, count as usize)
+                .iter_mut()
+                .filter_map(Option::take)
+                .collect()
+        };
+        CoTaskMemFree(Some(array.cast()));
+        Ok(found)
+    }
+}
+
+fn device_string(device: &IMFActivate, attribute: &GUID) -> Option<String> {
+    let mut text = PWSTR::null();
+    let mut len = 0;
+    // SAFETY: the API returns a CoTaskMem allocation with len UTF-16 units.
+    unsafe {
+        device
+            .GetAllocatedString(attribute, &mut text, &mut len)
+            .ok()?;
+        let value = if text.is_null() || len == 0 {
+            None
+        } else {
+            Some(String::from_utf16_lossy(slice::from_raw_parts(
+                text.0,
+                len as usize,
+            )))
+        };
+        CoTaskMemFree(Some(text.0.cast()));
+        value
+    }
+}
+
+pub fn list() -> Vec<(String, String)> {
+    let found = (|| {
+        let _platform = Platform::open()?;
+        Ok::<_, windows::core::Error>(
+            devices()?
+                .iter()
+                .filter_map(|device| {
+                    Some((
+                        device_string(
+                            device,
+                            &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_SYMBOLIC_LINK,
+                        )?,
+                        device_string(device, &MF_DEVSOURCE_ATTRIBUTE_FRIENDLY_NAME)
+                            .unwrap_or_default(),
+                    ))
+                })
+                .collect(),
+        )
+    })();
+    found.unwrap_or_else(|error| {
+        log::warn!("[CALL] Windows camera enumeration failed: {error}");
+        Vec::new()
+    })
+}
+
+#[cfg(test)]
+pub(crate) fn authorize() -> Result<(), String> {
+    // Windows checks camera access when the source is opened.
+    Ok(())
+}
+
+#[derive(Clone, Copy)]
+struct Format {
+    mode: Mode,
+    stride: Option<i32>,
+}
+
+impl Format {
+    fn from_media_type(media_type: &IMFMediaType) -> Option<Self> {
+        // SAFETY: the media type lives through these value reads.
+        let (pixel, size, rate, stride) = unsafe {
+            let pixel = match media_type.GetGUID(&MF_MT_SUBTYPE).ok()? {
+                MFVideoFormat_NV12 => Pixel::Nv12,
+                MFVideoFormat_YUY2 => Pixel::Yuyv,
+                MFVideoFormat_MJPG => Pixel::Mjpeg,
+                MFVideoFormat_RGB24 => Pixel::Bgr,
+                MFVideoFormat_L8 | GRAY8 => Pixel::Gray,
+                _ => return None,
+            };
+            (
+                pixel,
+                media_type.GetUINT64(&MF_MT_FRAME_SIZE).ok()?,
+                media_type.GetUINT64(&MF_MT_FRAME_RATE).unwrap_or(0),
+                media_type.GetUINT32(&MF_MT_DEFAULT_STRIDE).ok(),
+            )
+        };
+        let (width, height) = ((size >> 32) as u32, size as u32);
+        if width < 2 || height < 2 || width > 8192 || height > 8192 {
+            return None;
+        }
+        if matches!(pixel, Pixel::Nv12 | Pixel::Yuyv) && !width.is_multiple_of(2) {
+            return None;
+        }
+        let (numerator, denominator) = (rate >> 32, u64::from(rate as u32));
+        let fps = (numerator + denominator / 2)
+            .checked_div(denominator)
+            .unwrap_or(30);
+        Some(Self {
+            mode: Mode {
+                width,
+                height,
+                fps: fps as u32,
+                pixel,
+            },
+            stride: stride.map(|stride| stride as i32),
+        })
+    }
+
+    /// Normalize linear samples or the packed result of a 2D copy. NV12 uses
+    /// the same byte pitch for luma and interleaved chroma.
+    fn packed<'a>(
+        &self,
+        source: &'a [u8],
+        contiguous: bool,
+        rows: &'a mut Vec<u8>,
+    ) -> Option<&'a [u8]> {
+        let width = self.mode.width as usize;
+        let height = self.mode.height as usize;
+        let (row_bytes, row_count, packed_pitch) = match self.mode.pixel {
+            Pixel::Nv12 => (width, height + height.div_ceil(2), width),
+            Pixel::Yuyv => (width * 2, height, width * 2),
+            Pixel::Bgr => (width * 3, height, (width * 3).next_multiple_of(4)),
+            Pixel::Gray => (width, height, width),
+            Pixel::Mjpeg => return (!source.is_empty()).then_some(source),
+            Pixel::I420 | Pixel::Rgb => return None,
+        };
+        let pitch = self.stride.map(|stride| stride.unsigned_abs() as usize);
+        let reverse = self.mode.pixel == Pixel::Bgr && self.stride.is_none_or(|stride| stride < 0);
+        let pitch = if contiguous {
+            packed_pitch
+        } else if let Some(pitch) = pitch.filter(|&pitch| {
+            pitch >= row_bytes && pitch * row_count == source.len()
+        }) {
+            pitch
+        } else if packed_pitch * row_count == source.len() {
+            packed_pitch
+        } else {
+            row_bytes
+        };
+        if pitch * row_count != source.len() {
+            return None;
+        }
+        if pitch == row_bytes && !reverse {
+            return Some(source);
+        }
+        rows.clear();
+        for row in 0..row_count {
+            let row = if reverse { row_count - 1 - row } else { row };
+            let offset = row * pitch;
+            rows.extend_from_slice(&source[offset..offset + row_bytes]);
+        }
+        Some(rows)
+    }
+}
+
+pub struct Camera {
+    reader: IMFSourceReader,
+    _platform: Platform,
+    format: Format,
+    contiguous: Vec<u8>,
+    rows: Vec<u8>,
+    reported_bad_layout: bool,
+}
+
+impl Camera {
+    pub fn open(id: &str, budget: (usize, usize), fps: u32) -> Result<Self, String> {
+        Self::open_media(id, budget, fps).map_err(|error| format!("Windows camera: {error}"))
+    }
+
+    fn open_media(id: &str, budget: (usize, usize), fps: u32) -> anyhow::Result<Self> {
+        let platform = Platform::open()?;
+        let device = devices()?
+            .into_iter()
+            .find(|device| {
+                device_string(device, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_SYMBOLIC_LINK)
+                    .as_deref()
+                    == Some(id)
+            })
+            .ok_or_else(|| anyhow::anyhow!("camera is no longer available"))?;
+        // SAFETY: the device, source and reader live on this initialized thread.
+        let (reader, format) = unsafe {
+            let source: IMFMediaSource = device.ActivateObject()?;
+            // A successfully created reader will shut down the source when it
+            // drops. A source with no reader still needs explicit shutdown.
+            let reader = match MFCreateSourceReaderFromMediaSource(&source, None::<&IMFAttributes>) {
+                Ok(reader) => reader,
+                Err(error) => {
+                    let _ = source.Shutdown();
+                    return Err(error.into());
+                }
+            };
+            reader.SetStreamSelection(MF_SOURCE_READER_ALL_STREAMS.0 as u32, false)?;
+            reader.SetStreamSelection(VIDEO, true)?;
+            let mut native = Vec::new();
+            for index in 0.. {
+                match reader.GetNativeMediaType(VIDEO, index) {
+                    Ok(media_type) => {
+                        if let Some(format) = Format::from_media_type(&media_type) {
+                            native.push((format.mode, media_type));
+                        }
+                    }
+                    Err(error) if error.code() == MF_E_NO_MORE_TYPES => break,
+                    Err(error) => return Err(error.into()),
+                }
+            }
+            let modes: Vec<_> = native.iter().map(|(mode, _)| *mode).collect();
+            if let Some(chosen) = super::choose_mode(&modes, budget, fps)
+                && let Some((_, media_type)) = native.iter().find(|(mode, _)| *mode == chosen)
+                && let Err(error) = reader.SetCurrentMediaType(VIDEO, None, media_type)
+            {
+                log::warn!("[CALL] Windows camera kept its default mode: {error}");
+            }
+            let format = Format::from_media_type(&reader.GetCurrentMediaType(VIDEO)?)
+                .ok_or_else(|| anyhow::anyhow!("camera did not offer a supported pixel format"))?;
+            (reader, format)
+        };
+        Ok(Self {
+            reader,
+            _platform: platform,
+            format,
+            contiguous: Vec::new(),
+            rows: Vec::new(),
+            reported_bad_layout: false,
+        })
+    }
+
+    pub fn mode(&self) -> Mode {
+        self.format.mode
+    }
+
+    pub fn read<R>(
+        &mut self,
+        convert: impl FnOnce(Pixel, &[u8], usize, usize, usize) -> R,
+    ) -> Result<R, String> {
+        self.read_media(convert).map_err(|error| error.to_string())
+    }
+
+    fn read_media<R>(
+        &mut self,
+        convert: impl FnOnce(Pixel, &[u8], usize, usize, usize) -> R,
+    ) -> anyhow::Result<R> {
+        let sample = loop {
+            let mut flags = 0;
+            let mut sample = None;
+            // SAFETY: the reader and out arguments live throughout the call.
+            unsafe {
+                self.reader
+                    .ReadSample(VIDEO, 0, None, Some(&mut flags), None, Some(&mut sample))?
+            };
+            if flags & (MF_SOURCE_READERF_ERROR.0 | MF_SOURCE_READERF_ENDOFSTREAM.0) as u32 != 0 {
+                anyhow::bail!("the camera ended its video stream");
+            }
+            if flags & MF_SOURCE_READERF_CURRENTMEDIATYPECHANGED.0 as u32 != 0 {
+                // SAFETY: read the negotiated format from this thread's reader.
+                let media_type = unsafe { self.reader.GetCurrentMediaType(VIDEO)? };
+                self.format = Format::from_media_type(&media_type).ok_or_else(|| {
+                    anyhow::anyhow!("the camera changed to an unsupported pixel format")
+                })?;
+            }
+            if let Some(sample) = sample {
+                break sample;
+            }
+        };
+        // SAFETY: the sample owns the returned buffer reference.
+        let buffer = unsafe { sample.ConvertToContiguousBuffer()? };
+        let lock;
+        let (bytes, contiguous) = if let Ok(buffer_2d) = buffer.cast::<IMF2DBuffer>() {
+            // SAFETY: the OS reports the required copy size and uses the
+            // slice length when copying the packed representation.
+            let len = unsafe { buffer_2d.GetContiguousLength()? } as usize;
+            anyhow::ensure!(len <= MAX_FRAME_BYTES, "the camera frame is too large");
+            self.contiguous.resize(len, 0);
+            unsafe { buffer_2d.ContiguousCopyTo(&mut self.contiguous)? };
+            (self.contiguous.as_slice(), true)
+        } else {
+            lock = BufferLock::open(&buffer)?;
+            (lock.bytes(), false)
+        };
+        let mode = self.format.mode;
+        let packed = self.format.packed(bytes, contiguous, &mut self.rows);
+        if packed.is_none() && !self.reported_bad_layout {
+            self.reported_bad_layout = true;
+            log::warn!(
+                "[CALL] skipping incomplete Windows camera frame: {:?} {}x{}, {} bytes",
+                mode.pixel, mode.width, mode.height, bytes.len()
+            );
+        }
+        Ok(convert(
+            mode.pixel,
+            packed.unwrap_or(&[]),
+            mode.width as usize,
+            mode.height as usize,
+            mode.width as usize,
+        ))
+    }
+
+    pub fn stop(&mut self) {
+        // The reader and its media source are released when the camera drops.
+    }
+}
+
+struct BufferLock<'a> {
+    buffer: &'a IMFMediaBuffer,
+    data: *const u8,
+    len: usize,
+}
+
+impl<'a> BufferLock<'a> {
+    fn open(buffer: &'a IMFMediaBuffer) -> windows::core::Result<Self> {
+        let mut data = ptr::null_mut();
+        let mut len = 0;
+        // SAFETY: both out arguments are valid, and the returned guard keeps
+        // the buffer locked through every use of the pointer.
+        unsafe { buffer.Lock(&mut data, None, Some(&mut len))? };
+        Ok(Self {
+            buffer,
+            data,
+            len: len as usize,
+        })
+    }
+
+    fn bytes(&self) -> &[u8] {
+        if self.data.is_null() || self.len == 0 || self.len > MAX_FRAME_BYTES {
+            return &[];
+        }
+        // SAFETY: Lock returned this initialized range and Drop has not run.
+        unsafe { slice::from_raw_parts(self.data, self.len) }
+    }
+}
+
+impl Drop for BufferLock<'_> {
+    fn drop(&mut self) {
+        // SAFETY: this guard was created only by a successful Lock.
+        if let Err(error) = unsafe { self.buffer.Unlock() } {
+            log::warn!("[CALL] the Windows camera buffer could not be unlocked: {error}");
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn padded_nv12_retains_both_chroma_rows() {
+        let format = Format {
+            mode: Mode {
+                width: 2,
+                height: 4,
+                fps: 30,
+                pixel: Pixel::Nv12,
+            },
+            stride: Some(4),
+        };
+        let input = [
+            16, 17, 0, 0, 18, 19, 0, 0, 20, 21, 0, 0, 22, 23, 0, 0,
+            100, 150, 0, 0, 110, 140, 0, 0,
+        ];
+        let mut scratch = Vec::new();
+        let packed = format.packed(&input, false, &mut scratch).unwrap();
+        let picture = super::super::to_i420(Pixel::Nv12, packed, 2, 4).unwrap();
+        assert_eq!(picture.y, [16, 17, 18, 19, 20, 21, 22, 23]);
+        assert_eq!(picture.u, [100, 110]);
+        assert_eq!(picture.v, [150, 140]);
+        assert!(format.packed(&input[..20], false, &mut scratch).is_none());
+    }
+
+    #[test]
+    fn already_packed_nv12_uses_its_actual_layout() {
+        let format = Format {
+            mode: Mode {
+                width: 2,
+                height: 2,
+                fps: 30,
+                pixel: Pixel::Nv12,
+            },
+            stride: Some(16),
+        };
+        let input = [16, 17, 18, 19, 100, 150];
+        assert_eq!(
+            format.packed(&input, true, &mut Vec::new()),
+            Some(input.as_slice())
+        );
+    }
+}
